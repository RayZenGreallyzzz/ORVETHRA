{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ORVETHRA client command envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "type", "request_id", "seq", "payload"],
  "properties": {
    "v": {"const": 1},
    "type": {"enum": ["move_intent", "cast_skill", "pickup", "equip", "buy", "trade_offer", "trade_confirm"]},
    "request_id": {"type": "string", "minLength": 8, "maxLength": 80, "pattern": "^[A-Za-z0-9_-]+$"},
    "seq": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "payload": {"type": "object", "maxProperties": 12}
  }
}
